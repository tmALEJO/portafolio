---
import LogoSvg from "../icons/Logo.svg";
import cv from "../cv.json";

const { basics } = cv;
const year = new Date().getFullYear();
---

<footer class="relative z-20 w-full bg-gradient-to-r from-black via-indigo-950 to-black text-gray-300 mt-20 backdrop-blur-xl border-t border-white/5 shadow-[0_-40px_80px_rgba(0,0,0,0.9)]">

  <div class="relative max-w-[1392px] mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-3 gap-10">

    <!-- Logo -->
    <div>
      <div class="flex items-center gap-x-3 mb-4">
        <LogoSvg class="w-10 h-10 drop-shadow-[0_0_10px_#38bdf8]" />
        <span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-blue-500">
          Alejo Tello
        </span>
      </div>
      <p class="text-sm leading-relaxed text-gray-400">
        Portafolio personal — desarrollo de software, Machine Learning, TinyML y tecnologías web 🚀
      </p>
    </div>

    <!-- Navegación -->
    <div>
      <h3 class="text-sm font-semibold text-cyan-300 mb-4 uppercase tracking-widest">Navegación</h3>
      <ul class="space-y-2">
        <li><a href="/" class="text-gray-400 hover:text-cyan-400 hover:translate-x-1 inline-block transition-all duration-300 text-sm">🏠 Inicio</a></li>
        <li><a href="/about" class="text-gray-400 hover:text-cyan-400 hover:translate-x-1 inline-block transition-all duration-300 text-sm">👤 Sobre mí</a></li>
        <li><a href="/projects" class="text-gray-400 hover:text-cyan-400 hover:translate-x-1 inline-block transition-all duration-300 text-sm">🚀 Proyectos</a></li>
        <li><a href="/contact" class="text-gray-400 hover:text-cyan-400 hover:translate-x-1 inline-block transition-all duration-300 text-sm">📡 Contacto</a></li>
      </ul>
    </div>

    <!-- Contacto -->
    <div>
      <h3 class="text-sm font-semibold text-cyan-300 mb-4 uppercase tracking-widest">Contacto</h3>
      <ul class="space-y-3 text-sm">
        <li>
          <span class="text-white">📧</span>
          <a href={`mailto:${basics.email}`} class="hover:text-cyan-300 transition-colors ml-2 text-gray-400">
            {basics.email}
          </a>
        </li>
        <li>
          <span class="text-white">📱</span>
          <a
            href={`https://wa.me/${basics.phone.replace(/\D/g,"")}?text=Hola%20Alejo,%20vi%20tu%20portafolio`}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-green-300 transition-colors ml-2 text-gray-400"
          >
            {basics.phone}
          </a>
        </li>
        <li>
          <span class="text-white">📍</span>
          <span class="ml-2 text-gray-400">{basics.location.city}, {basics.location.region}</span>
        </li>
      </ul>

      <div class="flex gap-4 mt-5 text-2xl">
        <a href={basics.profiles[0].url} target="_blank" rel="noopener noreferrer" title="GitHub" class="hover:text-cyan-400 hover:scale-125 transition-transform duration-300">🐙</a>
        <a href={basics.profiles[1]?.url || "#"} target="_blank" rel="noopener noreferrer" title="LinkedIn" class="hover:text-sky-400 hover:scale-125 transition-transform duration-300">💼</a>
        <a href={basics.url} target="_blank" rel="noopener noreferrer" title="Portafolio" class="hover:text-indigo-400 hover:scale-125 transition-transform duration-300">🌐</a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/5 py-4 text-center text-xs text-gray-500">
    © {year} <span class="text-cyan-400 font-semibold">Francisco Alejandro Tello</span>. Todos los derechos reservados.
  </div>
</footer>
