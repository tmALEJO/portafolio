---
import cv from "../cv.json";
const { basics, work, education, skills, languages, projects } = cv;
---

<main
  id="bio"
  class="w-full min-h-screen flex items-center justify-center
             bg-[url('/fondo-nube.jpg')] bg-cover bg-center bg-no-repeat relative font-sans text-white"
>
  <!-- Overlay oscuro -->
  <div class="absolute inset-0 bg-black/70"></div>

  <!-- Contenido principal -->
  <div
    class="relative z-10 text-center px-6 py-10 transition-all duration-500 w-full"
  >
    <!-- Foto -->
    <div
      class="w-40 h-40 mx-auto rounded-full overflow-hidden border-4 border-cyan-400
                shadow-[0_0_30px_#22d3ee] mb-6 bg-black/50 flex items-center justify-center animate-pulse"
    >
      <img
        src={basics.image}
        alt="Foto de perfil"
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Nombre -->
    <h1
      class="text-5xl font-extrabold mb-3
               bg-gradient-to-r from-cyan-400 via-sky-500 to-blue-500
               bg-clip-text text-transparent drop-shadow-[0_0_15px_#38bdf8] transition-transform duration-300 hover:scale-105"
    >
      {basics.name}
    </h1>

    <!-- Rol / Label -->
    <p
      class="text-xl text-gray-200 mb-8 tracking-wide transition-transform duration-300 hover:scale-105"
    >
      {basics.label}
    </p>

    <!-- Contenedor -->
    <div
      class="max-w-4xl mx-auto bg-white/5 p-8 rounded-2xl shadow-[0_0_25px_#1e40af] border border-white/10 backdrop-blur-sm transition-all duration-300 hover:shadow-[0_0_35px_#0ea5e9] hover:scale-[1.01]"
    >
      <!-- 🚀 Sobre mí -->
      <section id="sobre-mi">
        <h2
          class="text-3xl font-semibold text-cyan-300 mb-4 drop-shadow-[0_0_10px_#22d3ee]"
        >
          🚀 Sobre mí
        </h2>
        <p
          class="text-lg text-gray-300 leading-relaxed mb-10 transition-transform duration-300 hover:scale-[1.01]"
          set:html={basics.summary}
        />
      </section>

      <!-- 💼 Experiencia -->
      <section id="experiencia" class="mt-10 text-left">
        <h3
          class="text-2xl font-semibold mb-6 text-center bg-gradient-to-r from-sky-400 to-blue-500 bg-clip-text text-transparent drop-shadow-[0_0_10px_#38bdf8]"
        >
          💼 Experiencia Laboral
        </h3>

        {
          work.length > 0 ? (
            <div class="flex flex-col items-center gap-6">
              {work.map(
                ({
                  name,
                  position,
                  startDate,
                  endDate,
                  summary,
                  highlights,
                }) => {
                  const start = new Date(startDate);
                  const startStr = start.toLocaleDateString("es-CO", {
                    month: "short",
                    year: "numeric",
                  });
                  const endStr = endDate
                    ? new Date(endDate).toLocaleDateString("es-CO", {
                        month: "short",
                        year: "numeric",
                      })
                    : "Actual";
                  return (
                    <article
                      class="w-full max-w-xl bg-white/10 border border-cyan-400/30 p-6 rounded-xl 
                                  shadow-[0_0_15px_#0ea5e9] hover:shadow-[0_0_30px_#38bdf8] hover:scale-[1.03] transition-all duration-300"
                    >
                      <header class="flex justify-between items-start mb-3 gap-2">
                        <div>
                          <h3 class="text-xl font-bold text-cyan-300">
                            {name}
                          </h3>
                          <h4 class="text-sm text-blue-300 mt-0.5">
                            {position}
                          </h4>
                        </div>
                        <time class="text-xs text-gray-400 italic whitespace-nowrap mt-1 bg-white/5 px-2 py-1 rounded-lg border border-white/10">
                          {startStr} — {endStr}
                        </time>
                      </header>
                      <p class="text-gray-300 text-sm mb-3">{summary}</p>
                      {highlights?.length > 0 && (
                        <ul class="mt-2 list-none space-y-1 text-gray-400 text-sm">
                          {highlights.map((item) => (
                            <li class="flex items-start gap-2">
                              <span class="text-cyan-400 mt-0.5">▹</span>
                              <span>{item}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </article>
                  );
                },
              )}
            </div>
          ) : (
            <div
              class="w-full max-w-xl mx-auto bg-white/10 border border-cyan-400/30 p-5 rounded-xl 
                        shadow-[0_0_15px_#0ea5e9] text-center text-gray-300 hover:scale-[1.03] transition-transform duration-300"
            >
              Aún no tengo experiencia laboral formal, pero he trabajado en
              <span class="text-cyan-400 font-semibold">
                {" "}
                proyectos académicos
              </span>{" "}
              y<span class="text-blue-400 font-semibold"> personales</span>{" "}
              enfocados en desarrollo web y ciberseguridad.
            </div>
          )
        }
      </section>

      <!-- 🎓 Educación -->
      <section class="mt-12 text-left">
        <h3
          class="text-2xl font-semibold text-center bg-gradient-to-r from-cyan-400 via-sky-500 to-blue-500 bg-clip-text text-transparent drop-shadow-[0_0_15px_#38bdf8]"
        >
          🎓 Educación
        </h3>
        {
          education.map(
            ({ institution, area, studyType, startDate, endDate, summary }) => {
              const startYear = new Date(startDate).getFullYear();
              const endYear = endDate
                ? new Date(endDate).getFullYear()
                : "Actualidad";
              return (
                <article class="bg-white/10 border border-cyan-400/30 p-5 rounded-xl mt-6 shadow-[0_0_15px_#0ea5e9] hover:shadow-[0_0_30px_#38bdf8] hover:scale-[1.03] transition-all duration-300">
                  <h4 class="text-xl font-bold text-cyan-300">{institution}</h4>
                  <p class="text-gray-300">
                    {studyType} en{" "}
                    <span class="text-blue-400 font-semibold">{area}</span>
                  </p>
                  <p class="text-gray-400 text-sm italic mb-2">
                    {startYear} – {endYear}
                  </p>
                  <p class="text-gray-300 text-sm" set:html={summary} />
                </article>
              );
            },
          )
        }
      </section>

      <!-- 🧠 Habilidades -->
      <section class="mt-12 text-left">
        <h3
          class="text-2xl font-semibold text-center bg-gradient-to-r from-pink-400 to-purple-500 bg-clip-text text-transparent drop-shadow-[0_0_15px_#e879f9]"
        >
          🧠 Habilidades
        </h3>

        <!-- 💻 Desarrollo Web -->
        <div class="mt-8">
          <h4
            class="text-lg font-semibold text-cyan-300 mb-4 border-l-4 border-cyan-400 pl-3"
          >
            💻 Desarrollo Web
          </h4>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {
              skills
                .filter((skill) =>
                  [
                    "HTML",
                    "CSS",
                    "JavaScript",
                    "React",
                    "TypeScript",
                    "Django",
                  ].includes(skill.name),
                )
                .map((skill) => (
                  <div
                    class="bg-white/10 border border-cyan-400/30 p-3 rounded-xl text-center 
                      shadow-[0_0_10px_#0ea5e9] hover:shadow-[0_0_25px_#38bdf8] hover:scale-[1.08] transition-all duration-300"
                  >
                    <h4 class="text-cyan-300 font-semibold">{skill.name}</h4>
                    <p class="text-sm text-gray-400">{skill.level}</p>
                  </div>
                ))
            }
          </div>
        </div>

        <!-- 🗄️ Bases de Datos y Datos -->
        <div class="mt-10">
          <h4
            class="text-lg font-semibold text-blue-300 mb-4 border-l-4 border-blue-400 pl-3"
          >
            🗄️ Bases de Datos y Datos
          </h4>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {
              skills
                .filter((skill) =>
                  ["MySQL", "Bases de Datos", "Análisis de Datos"].includes(
                    skill.name,
                  ),
                )
                .map((skill) => (
                  <div
                    class="bg-white/10 border border-blue-400/30 p-3 rounded-xl text-center 
                      shadow-[0_0_10px_#2563eb] hover:shadow-[0_0_25px_#3b82f6] hover:scale-[1.08] transition-all duration-300"
                  >
                    <h4 class="text-blue-300 font-semibold">{skill.name}</h4>
                    <p class="text-sm text-gray-400">{skill.level}</p>
                  </div>
                ))
            }
          </div>
        </div>

        <!-- 🤖 IA y TinyML -->
        <div class="mt-10">
          <h4
            class="text-lg font-semibold text-purple-300 mb-4 border-l-4 border-purple-400 pl-3"
          >
            🤖 IA y TinyML
          </h4>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {
              skills
                .filter((skill) =>
                  [
                    "Machine Learning",
                    "IoT / TinyML",
                    "Python",
                    "Edge Impulse",
                  ].includes(skill.name),
                )
                .map((skill) => (
                  <div
                    class="bg-white/10 border border-purple-400/30 p-3 rounded-xl text-center 
                      shadow-[0_0_10px_#9333ea] hover:shadow-[0_0_25px_#a855f7] hover:scale-[1.08] transition-all duration-300"
                  >
                    <h4 class="text-purple-300 font-semibold">{skill.name}</h4>
                    <p class="text-sm text-gray-400">{skill.level}</p>
                  </div>
                ))
            }
          </div>
        </div>

        <!-- 🌐 Redes y Seguridad -->
        <div class="mt-10">
          <h4
            class="text-lg font-semibold text-pink-300 mb-4 border-l-4 border-pink-400 pl-3"
          >
            🌐 Redes y Seguridad
          </h4>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {
              skills
                .filter((skill) =>
                  ["Redes", "Seguridad Informática"].includes(skill.name),
                )
                .map((skill) => (
                  <div
                    class="bg-white/10 border border-pink-400/30 p-3 rounded-xl text-center 
                      shadow-[0_0_10px_#ec4899] hover:shadow-[0_0_25px_#f472b6] hover:scale-[1.08] transition-all duration-300"
                  >
                    <h4 class="text-pink-300 font-semibold">{skill.name}</h4>
                    <p class="text-sm text-gray-400">{skill.level}</p>
                  </div>
                ))
            }
          </div>
        </div>

        <!-- 🛠️ Herramientas y Lenguajes -->
        <div class="mt-10">
          <h4
            class="text-lg font-semibold text-green-300 mb-4 border-l-4 border-green-400 pl-3"
          >
            🛠️ Herramientas y Lenguajes
          </h4>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {
              skills
                .filter((skill) =>
                  ["Git & GitHub", "Java", "C++", "Google Colab"].includes(
                    skill.name,
                  ),
                )
                .map((skill) => (
                  <div
                    class="bg-white/10 border border-green-400/30 p-3 rounded-xl text-center 
                      shadow-[0_0_10px_#22c55e] hover:shadow-[0_0_25px_#4ade80] hover:scale-[1.08] transition-all duration-300"
                  >
                    <h4 class="text-green-300 font-semibold">{skill.name}</h4>
                    <p class="text-sm text-gray-400">{skill.level}</p>
                  </div>
                ))
            }
          </div>
        </div>
      </section>
      <!-- 🚀 Proyectos -->
      <section id="proyectos" class="mt-12 text-left">
        <h3
          class="text-2xl font-semibold text-center bg-gradient-to-r from-sky-400 via-cyan-400 to-blue-500 bg-clip-text text-transparent drop-shadow-[0_0_20px_#38bdf8]"
        >
          🚀 Proyectos Destacados
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
          {
            projects.map((p) => (
              <article class="bg-white/10 border border-cyan-400/30 p-5 rounded-xl shadow-[0_0_15px_#0ea5e9] hover:shadow-[0_0_30px_#38bdf8] hover:scale-[1.03] transition-all duration-300 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <h4 class="text-xl font-bold text-cyan-300">{p.name}</h4>
                    {p.isActive && (
                      <span class="text-xs bg-green-500/20 text-green-400 border border-green-500/30 px-2 py-0.5 rounded-full">
                        Activo
                      </span>
                    )}
                  </div>
                  <p class="text-gray-300 text-sm mb-2">{p.description}</p>
                  {p.highlights && (
                    <ul class="list-none space-y-0.5 text-gray-400 text-sm mb-2">
                      {p.highlights.map((h) => (
                        <li class="flex items-start gap-2">
                          <span class="text-cyan-400 mt-0.5">▹</span>
                          <span>{h}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                {p.url && (
                  <a
                    href={p.url}
                    target="_blank"
                    rel="noopener"
                    class="inline-block mt-3 text-sky-400 text-sm hover:text-sky-300 hover:underline transition-colors duration-200"
                  >
                    🔗 Ver proyecto
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <!-- 🌍 Idiomas -->
      <section class="mt-12 text-left">
        <h3
          class="text-2xl font-semibold text-center bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent drop-shadow-[0_0_15px_#38bdf8]"
        >
          🌍 Idiomas
        </h3>
        <div class="flex justify-center flex-wrap gap-4 mt-6">
          {
            languages.map((lang) => (
              <span class="bg-white/10 border border-cyan-400/30 px-4 py-2 rounded-full text-gray-200 shadow-[0_0_10px_#0ea5e9] hover:shadow-[0_0_20px_#38bdf8] hover:scale-[1.1] transition-all duration-300">
                {lang.language} —{" "}
                <span class="text-cyan-300 font-semibold">{lang.fluency}</span>
              </span>
            ))
          }
        </div>
      </section>
    </div>
    <!-- 📡 Contacto -->
    <section id="contacto" class="mt-16 text-center">
      <h3
        class="text-3xl font-semibold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent drop-shadow-[0_0_15px_#38bdf8] mb-8"
      >
        📡 Contacto
      </h3>

      <div
        class="max-w-3xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6"
      >
        <!-- 📧 Correo -->
        <a
          href={`mailto:${basics.email}?subject=Contacto desde tu portafolio`}
          class="bg-white/10 border border-cyan-400/30 p-5 rounded-2xl
         shadow-[0_0_15px_#0ea5e9] hover:shadow-[0_0_30px_#38bdf8]
         hover:scale-105 transition-all duration-300 backdrop-blur-sm"
        >
          <div class="text-3xl mb-2">📧</div>
          <h4 class="text-cyan-300 font-semibold">Correo</h4>
          <p class="text-gray-400 text-sm break-all">{basics.email}</p>
        </a>

        <!-- 📱 WhatsApp -->
        <a
          href={`https://wa.me/${basics.phone.replace(/\D/g, "")}?text=Hola%20Alejo,%20vi%20tu%20portafolio%20y%20me%20interesa%20contactarte`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/10 border border-green-400/30 p-5 rounded-2xl
         shadow-[0_0_15px_#22c55e] hover:shadow-[0_0_30px_#4ade80]
         hover:scale-105 transition-all duration-300 backdrop-blur-sm"
        >
          <div class="text-3xl mb-2">📱</div>
          <h4 class="text-green-300 font-semibold">WhatsApp</h4>
          <p class="text-gray-400 text-sm">{basics.phone}</p>
        </a>

        <!-- GitHub -->
        <a
          href={basics.profiles[0].url}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/10 border border-purple-400/30 p-5 rounded-2xl
              shadow-[0_0_15px_#9333ea] hover:shadow-[0_0_30px_#a855f7]
              hover:scale-105 transition-all duration-300 backdrop-blur-sm"
        >
          <div class="text-3xl mb-2">💻</div>
          <h4 class="text-purple-300 font-semibold">GitHub</h4>
          <p class="text-gray-400 text-sm">@{basics.profiles[0].username}</p>
        </a>

        <!-- LinkedIn -->
        <a
          href={basics.profiles[1].url}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white/10 border border-blue-400/30 p-5 rounded-2xl
              shadow-[0_0_15px_#2563eb] hover:shadow-[0_0_30px_#3b82f6]
              hover:scale-105 transition-all duration-300 backdrop-blur-sm"
        >
          <div class="text-3xl mb-2">🌐</div>
          <h4 class="text-blue-300 font-semibold">LinkedIn</h4>
          <p class="text-gray-400 text-sm">Perfil profesional</p>
        </a>
        <!-- Ubicación -->
        <div
          class="bg-white/10 border border-pink-400/30 p-5 rounded-2xl
            shadow-[0_0_15px_#ec4899] hover:shadow-[0_0_30px_#f472b6]
            hover:scale-105 transition-all duration-300 backdrop-blur-sm"
        >
          <div class="text-3xl mb-2">📍</div>
          <h4 class="text-pink-300 font-semibold">Ubicación</h4>
          <p class="text-gray-400 text-sm">
            {basics.location.city}, {basics.location.region}
          </p>
        </div>
      </div>
    </section>
    <!-- Botones -->
    <div class="mt-10 flex flex-wrap justify-center gap-6">
      <a
        href="#proyectos"
        class="bg-gradient-to-r from-cyan-500 to-blue-600 text-white px-8 py-3
                rounded-xl shadow-[0_0_15px_#0ea5e9] font-semibold
                hover:scale-110 hover:shadow-[0_0_30px_#38bdf8] transition-transform duration-300"
      >
        🔭 Ver proyectos
      </a>
      <a
        href="/cv.pdf"
        download
        class="bg-white/10 border border-white/30 text-white px-8 py-3
          rounded-xl shadow-md font-semibold backdrop-blur-sm
          hover:bg-white/20 hover:scale-110 transition-transform duration-300"
      >
        📄 Descargar CV(PDF)
      </a>
    </div>
  </div>
</main>
