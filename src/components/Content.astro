---
import cv from "../cv.json";
import LogoSvg1 from "../icons/space.svg?url";

const { basics } = cv;
---

<main
  id="bio"
  class="relative z-10 w-full min-h-screen flex items-center justify-center text-white"
>
  <div
    class="relative z-10 text-center px-6 py-12 w-full max-w-6xl mx-auto"
  >

    <!-- Avatar -->
    <div
      class="w-28 h-28 mx-auto rounded-full overflow-hidden border-4 border-cyan-400
             shadow-[0_0_40px_#22d3ee] mb-5 bg-black/50 flex items-center justify-center
             hover:shadow-[0_0_60px_#38bdf8] hover:scale-105 transition-all duration-500"
    >
      <img
        src={LogoSvg1}
        alt="Foto de perfil"
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Badge disponible -->
    <div
      class="inline-flex items-center gap-2 mb-4 px-4 py-1 rounded-full 
             border border-cyan-400/40 bg-cyan-400/10 text-cyan-300 
             text-xs tracking-widest uppercase"
    >
      <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
      Disponible para proyectos
    </div>

    <!-- Nombre -->
    <h1
      class="text-5xl md:text-6xl font-extrabold mb-2
             bg-gradient-to-r from-cyan-400 via-sky-500 to-blue-500
             bg-clip-text text-transparent drop-shadow-[0_0_20px_#38bdf8]"
    >
      {basics.name}
    </h1>

    <!-- Label -->
    <p class="text-lg text-gray-300 mb-3">
      {basics.label}
    </p>

    <!-- Resumen principal -->
    <p class="text-gray-400 text-base max-w-2xl mx-auto mb-6 leading-relaxed">
      Desarrollador Full-Stack con formación en Ingeniería Informática,
      apasionado por crear aplicaciones web, soluciones de IA y Machine Learning
      que resuelven problemas reales con tecnología innovadora.
    </p>

    <!-- Badges de tecnologías principales -->
    <div class="flex flex-wrap justify-center gap-2 mb-10">
      {["React", "Django", "Python", "TinyML", "MySQL", "Java", "Docker", "Git", "TensorFlow", "FastAPI", "PostgreSQL", "Tailwind"].map(
        (tech) => (
          <span
            class="px-3 py-1 rounded-full text-xs border border-cyan-400/30 
                   bg-cyan-400/5 text-cyan-300 hover:border-cyan-400/60 
                   hover:bg-cyan-400/10 transition-all duration-300"
          >
            {tech}
          </span>
        )
      )}
    </div>

    <!-- Tarjetas de navegación principal (más grandes y atractivas) -->
    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-12">
      <a
        href="/about"
        class="group bg-gradient-to-br from-white/5 to-white/0 border border-white/10 rounded-2xl p-6 text-left
               hover:border-cyan-400/40 hover:bg-cyan-400/5 hover:scale-[1.02]
               transition-all duration-300 backdrop-blur-sm"
      >
        <div class="text-4xl mb-3">👨‍💻</div>
        <h3 class="text-xl font-bold text-cyan-300 mb-2">Sobre mí</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          Mi perfil profesional, experiencia laboral, formación académica completa 
          y las habilidades que me definen como ingeniero.
        </p>
        <span class="inline-block mt-3 text-cyan-400 text-sm group-hover:translate-x-1 transition-all">→ Conoce más</span>
      </a>

      <a
        href="/projects"
        class="group bg-gradient-to-br from-white/5 to-white/0 border border-white/10 rounded-2xl p-6 text-left
               hover:border-purple-400/40 hover:bg-purple-400/5 hover:scale-[1.02]
               transition-all duration-300 backdrop-blur-sm"
      >
        <div class="text-4xl mb-3">🚀</div>
        <h3 class="text-xl font-bold text-purple-300 mb-2">Proyectos</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          Portafolio completo: aplicaciones web, videojuegos en Java, modelos de ML, 
          TinyML en dispositivos embebidos y soluciones con IA.
        </p>
        <span class="inline-block mt-3 text-purple-400 text-sm group-hover:translate-x-1 transition-all">→ Ver proyectos</span>
      </a>

      <a
        href="/contact"
        class="group bg-gradient-to-br from-white/5 to-white/0 border border-white/10 rounded-2xl p-6 text-left
               hover:border-green-400/40 hover:bg-green-400/5 hover:scale-[1.02]
               transition-all duration-300 backdrop-blur-sm"
      >
        <div class="text-4xl mb-3">📡</div>
        <h3 class="text-xl font-bold text-green-300 mb-2">Contacto</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          ¿Buscas un desarrollador para tu equipo? Escríbeme. Estoy abierto a 
          prácticas profesionales, freelance y tiempo completo.
        </p>
        <span class="inline-block mt-3 text-green-400 text-sm group-hover:translate-x-1 transition-all">→ Contactar</span>
      </a>
    </div>

    <!-- Proyecto destacado (más grande y detallado) -->
    <div class="max-w-4xl mx-auto mb-12">
      <div class="flex items-center justify-center gap-2 mb-4">
        <span class="text-xs text-gray-500 uppercase tracking-wider">⭐ Proyecto destacado</span>
        <span class="w-1 h-1 rounded-full bg-cyan-400"></span>
        <span class="text-xs text-cyan-400">TinyML</span>
      </div>
      <div class="bg-gradient-to-r from-cyan-500/15 via-blue-500/10 to-purple-500/15 rounded-2xl p-6 border border-cyan-500/30 text-left backdrop-blur-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-3xl">🧠</span>
          <div>
            <h4 class="text-lg font-bold text-white">Detección de anomalías en dispositivos Edge</h4>
            <p class="text-xs text-cyan-300">Modelo TinyML optimizado</p>
          </div>
        </div>
        <p class="text-gray-300 text-sm mb-4 leading-relaxed">
          Modelo de Machine Learning optimizado para microcontroladores de bajo consumo,
          capaz de detectar fallos en tiempo real en maquinaria industrial. Implementado 
          en ESP32 con TensorFlow Lite Micro.
        </p>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs bg-cyan-500/20 text-cyan-300 px-2 py-1 rounded-full">TensorFlow Lite</span>
          <span class="text-xs bg-purple-500/20 text-purple-300 px-2 py-1 rounded-full">Edge Impulse</span>
          <span class="text-xs bg-blue-500/20 text-blue-300 px-2 py-1 rounded-full">ESP32</span>
          <span class="text-xs bg-green-500/20 text-green-300 px-2 py-1 rounded-full">C++</span>
        </div>
        <div class="flex items-center gap-2 text-xs text-gray-400">
          <span>📅 2025</span>
          <span>•</span>
          <span>🏆 Proyecto de investigación</span>
        </div>
      </div>
    </div>

    <!-- Experiencia reciente (2 columnas + más información) -->
    <div class="max-w-4xl mx-auto mb-12">
      <p class="text-xs text-gray-500 uppercase tracking-wider mb-4 text-center">💼 Experiencia reciente</p>
      <div class="grid md:grid-cols-2 gap-5">
        <div class="bg-gradient-to-br from-white/5 to-white/0 rounded-xl p-5 border border-white/10 hover:border-cyan-400/30 transition-all duration-300 text-left">
          <div class="flex items-center justify-between mb-2">
            <p class="text-cyan-300 text-sm font-semibold">2024 - Actualidad</p>
            <span class="text-xs bg-cyan-500/20 text-cyan-300 px-2 py-0.5 rounded-full">Freelance</span>
          </div>
          <p class="text-white text-base font-medium mt-1">Desarrollador Full-Stack</p>
          <p class="text-gray-400 text-sm mt-1 leading-relaxed">
            Construcción de dashboards interactivos y APIs REST para clientes locales. 
            Tecnologías: React, Django REST Framework, PostgreSQL.
          </p>
          <div class="flex flex-wrap gap-1 mt-3">
            <span class="text-xs text-gray-500">#React</span>
            <span class="text-xs text-gray-500">#Django</span>
            <span class="text-xs text-gray-500">#PostgreSQL</span>
          </div>
        </div>

        <div class="bg-gradient-to-br from-white/5 to-white/0 rounded-xl p-5 border border-white/10 hover:border-purple-400/30 transition-all duration-300 text-left">
          <div class="flex items-center justify-between mb-2">
            <p class="text-purple-300 text-sm font-semibold">2026</p>
            <span class="text-xs bg-purple-500/20 text-purple-300 px-2 py-0.5 rounded-full">Investigación</span>
          </div>
          <p class="text-white text-base font-medium mt-1">Proyecto de investigación - TinyML</p>
          <p class="text-gray-400 text-sm mt-1 leading-relaxed">
            Implementación de modelos de Machine Learning en dispositivos de bajo costo 
            para monitoreo ambiental y detección temprana de anomalías.
          </p>
          <div class="flex flex-wrap gap-1 mt-3">
            <span class="text-xs text-gray-500">#TinyML</span>
            <span class="text-xs text-gray-500">#EdgeImpulse</span>
            <span class="text-xs text-gray-500">#ESP32</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Sección de tecnologías especializadas (con íconos y categorías) -->
    <div class="max-w-4xl mx-auto mb-12">
      <p class="text-xs text-gray-500 uppercase tracking-wider mb-4 text-center">⚡ Stack tecnológico</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="bg-white/5 rounded-xl p-3 text-center border border-white/10 hover:border-cyan-400/30 transition-all">
          <span class="text-2xl block mb-1">🌐</span>
          <p class="text-xs text-cyan-300 font-medium">Frontend</p>
          <p class="text-[11px] text-gray-500">React, Tailwind, Vite</p>
        </div>
        <div class="bg-white/5 rounded-xl p-3 text-center border border-white/10 hover:border-purple-400/30 transition-all">
          <span class="text-2xl block mb-1">⚙️</span>
          <p class="text-xs text-purple-300 font-medium">Backend</p>
          <p class="text-[11px] text-gray-500">Django, FastAPI, Java</p>
        </div>
        <div class="bg-white/5 rounded-xl p-3 text-center border border-white/10 hover:border-blue-400/30 transition-all">
          <span class="text-2xl block mb-1">🤖</span>
          <p class="text-xs text-blue-300 font-medium">ML / IA</p>
          <p class="text-[11px] text-gray-500">TensorFlow, TinyML, Keras</p>
        </div>
        <div class="bg-white/5 rounded-xl p-3 text-center border border-white/10 hover:border-green-400/30 transition-all">
          <span class="text-2xl block mb-1">🗄️</span>
          <p class="text-xs text-green-300 font-medium">Bases de Datos</p>
          <p class="text-[11px] text-gray-500">MySQL, PostgreSQL</p>
        </div>
      </div>
    </div>

    <!-- Formación académica destacada -->
    <div class="max-w-4xl mx-auto mb-12">
      <p class="text-xs text-gray-500 uppercase tracking-wider mb-4 text-center">🎓 Formación académica</p>
      <div class="bg-gradient-to-r from-cyan-500/5 to-blue-500/5 rounded-xl p-5 border border-white/10 text-left">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🎓</span>
          <div>
            <p class="text-white font-semibold">Ingeniería Informática</p>
            <p class="text-gray-400 text-sm">Corporación Universitaria Autónoma de Nariño</p>
          </div>
          <span class="ml-auto text-xs bg-cyan-500/20 text-cyan-300 px-2 py-1 rounded-full">9° Semestre</span>
        </div>
        <div class="mt-3 pl-10">
          <p class="text-gray-500 text-xs">📅 2022 - 2026 · En proceso de grado</p>
          <p class="text-gray-500 text-xs mt-1">📌 Pasto, Nariño</p>
        </div>
      </div>
    </div>

    <!-- Botones de acción -->
    <div class="flex flex-wrap justify-center gap-4 mb-8">
      <a
        href="/cv.pdf"
        target="_blank"
        class="px-6 py-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 text-white 
               rounded-full text-sm font-semibold shadow-[0_0_15px_#0ea5e9]
               hover:scale-105 hover:shadow-[0_0_25px_#38bdf8] transition-all duration-300"
      >
        📄 Descargar CV
      </a>
      <a
        href="https://github.com/tu-usuario"
        target="_blank"
        class="px-6 py-2.5 bg-white/5 border border-white/20 text-white 
               rounded-full text-sm font-semibold
               hover:bg-white/20 hover:scale-105 transition-all duration-300"
      >
        🐙 GitHub
      </a>
      <a
        href="https://linkedin.com/in/tu-perfil"
        target="_blank"
        class="px-6 py-2.5 bg-white/5 border border-white/20 text-white 
               rounded-full text-sm font-semibold
               hover:bg-white/20 hover:scale-105 transition-all duration-300"
      >
        🔗 LinkedIn
      </a>
    </div>

    <!-- Frase personal -->
    <div class="max-w-2xl mx-auto mb-6">
      <p class="text-gray-500 text-sm italic border-l-2 border-cyan-400/50 pl-4 text-left">
        "Convertir ideas en código funcional que impacte positivamente a las personas. 
        Siempre aprendiendo, siempre construyendo."
      </p>
    </div>

    <!-- Scroll hint -->
    <div class="text-gray-600 text-xs animate-pulse">
      <span class="block text-lg">▼</span>
      <p class="text-[10px] tracking-wider">EXPLORA EL PORTAFOLIO</p>
    </div>
  </div>
</main>