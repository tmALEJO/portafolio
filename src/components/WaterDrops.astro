---
import "../styles/galaxy.css";
---

<div id="galaxy-container">
  <canvas id="galaxy-canvas"></canvas>
</div>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const canvas = document.getElementById("galaxy-canvas");
  if (!canvas) return;

  const ctx = canvas.getContext("2d");
  if (!ctx) return;

  let stars = [];
  let dust = [];
  let planets = [];

  const mouse = { x: 0, y: 0 };
  let t = 0;

  const center = () => ({
    x: canvas.width / 2,
    y: canvas.height / 2
  });

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  window.addEventListener("resize", resize);
  resize();

  // 🌌 ESTRELLAS (GALAXIA DE FONDO)
  class Star {
    constructor() {
      this.angle = Math.random() * Math.PI * 2;
      this.radius = Math.random() * (window.innerWidth * 0.32);
      this.speed = Math.random() * 0.00045 + 0.0002;
      this.size = Math.random() * 1.4 + 0.3;
      this.opacity = Math.random() * 0.5 + 0.2;
    }

    update() {
      t += 0.00008;

      const a = this.angle + t * this.speed * 500;

      const c = center();

      const r = this.radius + Math.sin(t + this.radius) * 2;

      this.x = c.x + Math.cos(a) * r;
      this.y = c.y + Math.sin(a) * r * 0.55;

      // gravedad suave
      this.x += (c.x - this.x) * 0.00003;
      this.y += (c.y - this.y) * 0.00003;
    }

    draw() {
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);

      ctx.fillStyle = `rgba(56,189,248,${this.opacity})`;
      ctx.shadowBlur = 8;
      ctx.shadowColor = "#8b5cf6";

      ctx.fill();
    }
  }

  // 🌠 POLVO CÓSMICO
  class Dust {
    constructor() {
      this.x = Math.random() * window.innerWidth;
      this.y = Math.random() * window.innerHeight;
      this.size = Math.random() * 1.2;
      this.opacity = Math.random() * 0.25;
    }

    update() {
      this.y += 0.08;
      if (this.y > canvas.height) {
        this.y = 0;
        this.x = Math.random() * canvas.width;
      }
    }

    draw() {
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(167,139,250,${this.opacity})`;
      ctx.fill();
    }
  }

  // 🪐 PLANETAS CERCANOS (LO QUE PEDISTE)
  class Planet {
    constructor() {
      this.orbitRadius = Math.random() * 300 + 200; // 👈 cerca de bordes
      this.angle = Math.random() * Math.PI * 2;
      this.speed = Math.random() * 0.001 + 0.0003;

      this.size = Math.random() * 8 + 4;

      this.color = [
        "#38bdf8",
        "#8b5cf6",
        "#a78bfa",
        "#60a5fa"
      ][Math.floor(Math.random() * 4)];
    }

    update() {
      this.angle += this.speed;

      const c = center();

      this.x = c.x + Math.cos(this.angle) * this.orbitRadius;
      this.y = c.y + Math.sin(this.angle) * this.orbitRadius * 0.6;

      // ligera interacción mouse
      this.x += (mouse.x - this.x) * 0.00002;
      this.y += (mouse.y - this.y) * 0.00002;
    }

    draw() {
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);

      ctx.fillStyle = this.color;
      ctx.shadowBlur = 25;
      ctx.shadowColor = this.color;

      ctx.fill();
    }
  }

  function init() {
    stars = [];
    dust = [];
    planets = [];

    for (let i = 0; i < 240; i++) {
      stars.push(new Star());
    }

    for (let i = 0; i < 120; i++) {
      dust.push(new Dust());
    }

    // 🪐 planetas visibles alrededor de la pantalla
    for (let i = 0; i < 6; i++) {
      planets.push(new Planet());
    }
  }

  function drawBackground() {
    const c = center();

    const g = ctx.createRadialGradient(
      c.x,
      c.y,
      0,
      c.x,
      c.y,
      canvas.width
    );

    g.addColorStop(0, "rgba(15,10,35,0.6)");
    g.addColorStop(1, "rgba(0,0,0,0.98)");

    ctx.fillStyle = g;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // 🕳️ agujero negro central
    ctx.beginPath();
    ctx.arc(c.x, c.y, 60, 0, Math.PI * 2);
    ctx.fillStyle = "rgba(0,0,0,0.8)";
    ctx.fill();
  }

  function animate() {
    drawBackground();

    for (let i = 0; i < dust.length; i++) {
      dust[i].update();
      dust[i].draw();
    }

    for (let i = 0; i < stars.length; i++) {
      stars[i].update();
      stars[i].draw();
    }

    // 🪐 PLANETAS EN PRIMER PLANO (IMPORTANTE)
    for (let i = 0; i < planets.length; i++) {
      planets[i].update();
      planets[i].draw();
    }

    requestAnimationFrame(animate);
  }

  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  init();
  animate();
});
</script>