---
import LogoSvg from "../icons/baner.svg";

const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "🏠 Inicio" },
  { href: "/about", label: "👤 Sobre mí" },
  { href: "/projects", label: "🚀 Proyectos" },
  { href: "/contact", label: "📡 Contacto" },
];
---

<header
  class="relative w-full sticky top-0 z-50 backdrop-blur-md bg-black/50 border-b border-white/10 shadow-lg overflow-hidden"
>
  <!-- 🌌 Fondo espacial -->
  <div class="header-space"></div>
  <div class="header-stars"></div>
  <div class="header-extra1"></div>

  <div
    class="relative z-10 max-w-[1392px] mx-auto flex justify-between items-center px-6 py-4"
  >
    <!-- Logo + Nombre -->
    <a href="/" class="flex items-center gap-x-4 no-underline">
      <div
        class="w-16 h-16 flex items-center justify-center rounded-full border border-cyan-400/50
               shadow-[0_0_10px_#22d3ee] bg-black/40 transition-all duration-300
               hover:shadow-[0_0_20px_#38bdf8] hover:scale-105"
      >
        <LogoSvg
          class="w-12 h-12 text-cyan-400 drop-shadow-[0_0_8px_#22d3ee]"
          aria-label="Logo"
        />
      </div>

      <div>
        <span
          class="text-3xl font-bold tracking-wide bg-clip-text text-transparent
                 bg-gradient-to-r from-cyan-400 to-blue-500"
        >
          Alejo Tello
        </span>
        <p class="text-xs text-gray-400 tracking-[0.25em] uppercase mt-1">
          Full Stack • ING.Informatico • TinyML • Machine Learning
        </p>
      </div>
    </a>

    <!-- Botón Mobile -->
    <button
      id="menu-toggle"
      class="md:hidden text-cyan-300 hover:text-cyan-400 transition-colors duration-300"
      aria-label="Abrir menú"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-8 h-8"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- Navegación Desktop -->
    <nav class="hidden md:flex items-center gap-x-6 text-lg font-semibold">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`nav-link transition-all duration-300 hover:scale-110 hover:drop-shadow-[0_0_8px_#38bdf8]
            ${pathname === href
              ? "text-white drop-shadow-[0_0_10px_#38bdf8] border-b-2 border-cyan-400 pb-0.5"
              : "text-cyan-300 hover:text-cyan-400"
            }`}
        >
          {label}
        </a>
      ))}
      <a
        href="/CV_Francisco.pdf"
        download
        class="ml-2 px-4 py-2 bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-lg
               font-semibold shadow-[0_0_12px_#0ea5e9] hover:shadow-[0_0_24px_#38bdf8]
               hover:scale-105 transition-all duration-300 text-sm"
      >
        📄 CV
      </a>
    </nav>
  </div>

  <!-- Menú Mobile -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden flex-col px-6 pb-4 gap-y-3 text-lg font-semibold
           border-t border-white/10 bg-black/40 backdrop-blur-md relative z-10"
  >
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        class={`py-2 transition-colors duration-300
          ${pathname === href ? "text-white" : "text-cyan-300 hover:text-cyan-400"}`}
      >
        {label}
      </a>
    ))}
    <a
      href="public/CV_Francisco.pdf"
      download
      class="py-2 text-cyan-300 hover:text-cyan-400"
    >
      📄 Descargar CV
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
  });

  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
    });
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }

  .header-space {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at top,
      rgba(56, 189, 248, 0.12),
      rgba(0, 0, 0, 0.85)
    );
  }

  .header-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .header-stars::before {
    content: "";
    position: absolute;
    width: 200%;
    height: 200%;
    background-image:
      radial-gradient(1px 1px at 20px 30px, #ffd700, transparent),
      radial-gradient(1px 1px at 120px 80px, #ffffff, transparent),
      radial-gradient(1px 1px at 200px 150px, #facc15, transparent),
      radial-gradient(1px 1px at 300px 220px, #fff, transparent);
    opacity: 0.35;
    animation: starsMoveHeader 140s linear infinite;
  }

  @keyframes starsMoveHeader {
    from { transform: translateY(0); }
    to { transform: translateY(-1000px); }
  }

  .header-space::after {
    content: "";
    position: absolute;
    width: 70px;
    height: 70px;
    top: 20%;
    left: 12%;
    border-radius: 50%;
    background: radial-gradient(circle, #38bdf8, #1e3a8a);
    opacity: 0.35;
    animation: floatPlanet 20s ease-in-out infinite;
    box-shadow: 0 0 25px rgba(56, 189, 248, 0.3);
  }

  .header-space::before {
    content: "";
    position: absolute;
    width: 45px;
    height: 45px;
    bottom: 15%;
    right: 18%;
    border-radius: 50%;
    background: radial-gradient(circle, #facc15, #92400e);
    opacity: 0.3;
    animation: floatPlanet 28s ease-in-out infinite;
  }

  @keyframes floatPlanet {
    0% { transform: translateY(0px) translateX(0px); }
    50% { transform: translateY(-10px) translateX(8px); }
    100% { transform: translateY(0px) translateX(0px); }
  }
</style>
