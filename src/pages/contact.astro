---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaterDrops from '../components/WaterDrops.astro';
import cv from '../cv.json';

const { basics } = cv;
---

<Layout title="Contacto | Alejo Tello">
  <Header />
  <WaterDrops />

  <main class="relative z-10 w-full min-h-screen text-white pb-20">

    <!-- Hero -->
    <section class="flex flex-col items-center justify-center pt-20 pb-12 px-6 text-center">
      <div class="inline-block mb-4 px-4 py-1 rounded-full border border-cyan-400/40 bg-cyan-400/10 text-cyan-300 text-sm tracking-widest uppercase">
        ⬡ Respuesta en menos de 24h ⬡
      </div>
      <h1 class="text-5xl md:text-6xl font-extrabold mb-4 bg-gradient-to-r from-cyan-400 via-sky-400 to-blue-500 bg-clip-text text-transparent drop-shadow-[0_0_20px_#38bdf8]">
        Contacto
      </h1>
      <p class="text-gray-400 max-w-lg">
        ¿Tienes un proyecto en mente o quieres colaborar? Escríbeme, siempre estoy abierto a nuevas ideas.
      </p>
    </section>

    <!-- Grid principal -->
    <section class="max-w-5xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-10 mt-4">

      <!-- Info contacto -->
      <div class="flex flex-col gap-6">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 shadow-[0_0_25px_#0ea5e9]/20 backdrop-blur-sm">
          <h2 class="text-xl font-bold text-cyan-300 mb-6">Información de contacto</h2>

          <div class="flex flex-col gap-5">
            <a href={`mailto:${basics.email}`} class="flex items-center gap-4 group">
              <div class="w-12 h-12 rounded-xl bg-cyan-400/10 border border-cyan-400/30 flex items-center justify-center text-2xl shadow-[0_0_12px_#0ea5e9]/30 group-hover:shadow-[0_0_25px_#38bdf8]/50 transition-all">📧</div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-widest">Email</p>
                <p class="text-cyan-300 group-hover:text-cyan-200 transition-colors">{basics.email}</p>
              </div>
            </a>

            <a href={`https://wa.me/${basics.phone.replace(/\D/g,"")}?text=Hola%20Alejo,%20vi%20tu%20portafolio`} target="_blank" rel="noopener" class="flex items-center gap-4 group">
              <div class="w-12 h-12 rounded-xl bg-green-400/10 border border-green-400/30 flex items-center justify-center text-2xl shadow-[0_0_12px_#22c55e]/30 group-hover:shadow-[0_0_25px_#4ade80]/50 transition-all">📱</div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-widest">WhatsApp</p>
                <p class="text-green-300 group-hover:text-green-200 transition-colors">{basics.phone}</p>
              </div>
            </a>

            <a href={basics.profiles[0].url} target="_blank" rel="noopener" class="flex items-center gap-4 group">
              <div class="w-12 h-12 rounded-xl bg-purple-400/10 border border-purple-400/30 flex items-center justify-center text-2xl shadow-[0_0_12px_#9333ea]/30 group-hover:shadow-[0_0_25px_#a855f7]/50 transition-all">💻</div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-widest">GitHub</p>
                <p class="text-purple-300 group-hover:text-purple-200 transition-colors">@{basics.profiles[0].username}</p>
              </div>
            </a>

            <a href={basics.profiles[1].url} target="_blank" rel="noopener" class="flex items-center gap-4 group">
              <div class="w-12 h-12 rounded-xl bg-blue-400/10 border border-blue-400/30 flex items-center justify-center text-2xl shadow-[0_0_12px_#2563eb]/30 group-hover:shadow-[0_0_25px_#3b82f6]/50 transition-all">🌐</div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-widest">LinkedIn</p>
                <p class="text-blue-300 group-hover:text-blue-200 transition-colors">Perfil profesional</p>
              </div>
            </a>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-pink-400/10 border border-pink-400/30 flex items-center justify-center text-2xl">📍</div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-widest">Ubicación</p>
                <p class="text-pink-300">{basics.location.city}, {basics.location.region}, Colombia</p>
              </div>
            </div>
          </div>

          <!-- Horario -->
          <div class="mt-6 pt-6 border-t border-white/10">
            <p class="text-xs text-gray-500 uppercase tracking-widest mb-2">Horario de contacto</p>
            <p class="text-gray-300 text-sm">Lun – Vie: 8:00 – 18:00 (GMT-5)</p>
            <p class="text-cyan-400 text-xs mt-1">⚡ Disponible para trabajo remoto</p>
          </div>
        </div>

        <!-- Redes rápidas -->
        <div class="flex gap-3">
          <a href={basics.profiles[0].url} target="_blank" rel="noopener"
            class="flex-1 py-3 text-center rounded-xl bg-white/5 border border-white/10 text-gray-300 hover:border-cyan-400/50 hover:text-cyan-300 hover:bg-cyan-400/5 transition-all duration-300 text-sm font-semibold">
            🐙 GitHub
          </a>
          <a href={basics.profiles[1].url} target="_blank" rel="noopener"
            class="flex-1 py-3 text-center rounded-xl bg-white/5 border border-white/10 text-gray-300 hover:border-blue-400/50 hover:text-blue-300 hover:bg-blue-400/5 transition-all duration-300 text-sm font-semibold">
            💼 LinkedIn
          </a>
          <a href="/cv.pdf" download
            class="flex-1 py-3 text-center rounded-xl bg-gradient-to-r from-cyan-500/20 to-blue-600/20 border border-cyan-400/30 text-cyan-300 hover:border-cyan-400/60 hover:shadow-[0_0_20px_#0ea5e9]/40 transition-all duration-300 text-sm font-semibold">
            📄 CV
          </a>
        </div>
      </div>

      <!-- Formulario -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-6 shadow-[0_0_25px_#0ea5e9]/20 backdrop-blur-sm">
        <h2 class="text-xl font-bold text-cyan-300 mb-6">Enviar mensaje</h2>

        <form id="contact-form" class="flex flex-col gap-5" novalidate>
          <div>
            <label class="text-xs text-gray-400 uppercase tracking-widest mb-2 block">Nombre</label>
            <input
              type="text"
              id="name"
              placeholder="Tu nombre"
              class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:border-cyan-400/50 focus:shadow-[0_0_15px_#0ea5e9]/30 focus:outline-none transition-all duration-300"
            />
          </div>
          <div>
            <label class="text-xs text-gray-400 uppercase tracking-widest mb-2 block">Correo electrónico</label>
            <input
              type="email"
              id="email"
              placeholder="tu@email.com"
              class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:border-cyan-400/50 focus:shadow-[0_0_15px_#0ea5e9]/30 focus:outline-none transition-all duration-300"
            />
          </div>
          <div>
            <label class="text-xs text-gray-400 uppercase tracking-widest mb-2 block">Mensaje</label>
            <textarea
              id="message"
              rows="5"
              placeholder="Cuéntame sobre tu proyecto..."
              class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:border-cyan-400/50 focus:shadow-[0_0_15px_#0ea5e9]/30 focus:outline-none transition-all duration-300 resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full py-3 bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-xl font-semibold
                   shadow-[0_0_15px_#0ea5e9] hover:shadow-[0_0_30px_#38bdf8] hover:scale-[1.02] transition-all duration-300"
          >
            📡 Enviar Mensaje
          </button>
          <div id="form-status" class="text-center text-sm hidden"></div>
        </form>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto px-6 mt-16">
      <div class="flex items-center gap-3 mb-8">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent to-cyan-400/50"></div>
        <h2 class="text-2xl font-bold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent whitespace-nowrap">─── Preguntas frecuentes ───</h2>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent to-cyan-400/50"></div>
      </div>

      <div class="flex flex-col gap-4" id="faq-list">

        <div class="faq-item bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
          <button class="faq-toggle w-full flex justify-between items-center px-6 py-4 text-left text-cyan-300 font-semibold hover:bg-white/5 transition-colors">
            ¿Cuánto tardas en responder?
            <span class="faq-icon text-xl transition-transform duration-300">＋</span>
          </button>
          <div class="faq-body hidden px-6 pb-5 text-gray-400 text-sm">
            Normalmente respondo en menos de 24 horas hábiles. Para cosas urgentes, el WhatsApp es más rápido.
          </div>
        </div>

        <div class="faq-item bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
          <button class="faq-toggle w-full flex justify-between items-center px-6 py-4 text-left text-cyan-300 font-semibold hover:bg-white/5 transition-colors">
            ¿Estás disponible para freelance?
            <span class="faq-icon text-xl transition-transform duration-300">＋</span>
          </button>
          <div class="faq-body hidden px-6 pb-5 text-gray-400 text-sm">
            Sí, estoy disponible para proyectos freelance, prácticas y colaboraciones. Trabajo de forma remota sin problema.
          </div>
        </div>

        <div class="faq-item bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
          <button class="faq-toggle w-full flex justify-between items-center px-6 py-4 text-left text-cyan-300 font-semibold hover:bg-white/5 transition-colors">
            ¿Con qué tecnologías trabajas principalmente?
            <span class="faq-icon text-xl transition-transform duration-300">＋</span>
          </button>
          <div class="faq-body hidden px-6 pb-5 text-gray-400 text-sm">
            Python, Django, React, JavaScript, MySQL, y tecnologías de ML como TensorFlow y Edge Impulse para proyectos de IoT/TinyML.
          </div>
        </div>

        <div class="faq-item bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
          <button class="faq-toggle w-full flex justify-between items-center px-6 py-4 text-left text-cyan-300 font-semibold hover:bg-white/5 transition-colors">
            ¿Puedes hacer proyectos de ML / IoT?
            <span class="faq-icon text-xl transition-transform duration-300">＋</span>
          </button>
          <div class="faq-body hidden px-6 pb-5 text-gray-400 text-sm">
            Sí, tengo experiencia real con modelos LSTM, TinyML en ESP32 y Edge Impulse desde la práctica en ITD SAS.
          </div>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  // FAQ toggle
  document.querySelectorAll('.faq-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const body = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;
      const isOpen = !body.classList.contains('hidden');
      body.classList.toggle('hidden');
      icon.textContent = isOpen ? '＋' : '－';
      icon.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(45deg)';
    });
  });

  // Form submit — abre Gmail con los datos
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();

    if (!name || !email || !message) {
      const status = document.getElementById('form-status')!;
      status.className = 'text-center text-sm text-red-400';
      status.textContent = '⚠️ Por favor completa todos los campos.';
      status.classList.remove('hidden');
      return;
    }

    const subject = encodeURIComponent(`Contacto desde portafolio — ${name}`);
    const body = encodeURIComponent(`Nombre: ${name}\nCorreo: ${email}\n\nMensaje:\n${message}`);
    window.open(`https://mail.google.com/mail/u/0/?view=cm&to=alejotello65@email.com&su=${subject}&body=${body}`, '_blank');
  });
</script>
