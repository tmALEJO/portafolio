---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaterDrops from '../components/WaterDrops.astro';
import cv from '../cv.json';

const { basics, work, education, skills, languages } = cv;

// Skill groups con íconos y colores
const skillGroups = [
  {
    label: "Frontend",
    icon: "🌐",
    color: "cyan",
    border: "border-cyan-400/40",
    glow: "shadow-[0_0_12px_#0ea5e9]/30",
    glowHover: "hover:shadow-[0_0_22px_#38bdf8]/60",
    text: "text-cyan-300",
    bg: "bg-cyan-400/10",
    items: skills.filter(s => ["HTML","CSS","JavaScript","React","TypeScript"].includes(s.name))
  },
  {
    label: "Backend & Lenguajes",
    icon: "⚙️",
    color: "purple",
    border: "border-purple-400/40",
    glow: "shadow-[0_0_12px_#9333ea]/30",
    glowHover: "hover:shadow-[0_0_22px_#a855f7]/60",
    text: "text-purple-300",
    bg: "bg-purple-400/10",
    items: skills.filter(s => ["Python","Java","C++","Django"].includes(s.name))
  },
  {
    label: "ML & IoT",
    icon: "🤖",
    color: "pink",
    border: "border-pink-400/40",
    glow: "shadow-[0_0_12px_#ec4899]/30",
    glowHover: "hover:shadow-[0_0_22px_#f472b6]/60",
    text: "text-pink-300",
    bg: "bg-pink-400/10",
    items: skills.filter(s => ["Machine Learning","IoT / TinyML","Edge Impulse"].includes(s.name))
  },
  {
    label: "Datos & BD",
    icon: "🗄️",
    color: "blue",
    border: "border-blue-400/40",
    glow: "shadow-[0_0_12px_#2563eb]/30",
    glowHover: "hover:shadow-[0_0_22px_#3b82f6]/60",
    text: "text-blue-300",
    bg: "bg-blue-400/10",
    items: skills.filter(s => ["MySQL","Bases de Datos","Análisis de Datos"].includes(s.name))
  },
  {
    label: "Herramientas",
    icon: "🛠️",
    color: "green",
    border: "border-green-400/40",
    glow: "shadow-[0_0_12px_#22c55e]/30",
    glowHover: "hover:shadow-[0_0_22px_#4ade80]/60",
    text: "text-green-300",
    bg: "bg-green-400/10",
    items: skills.filter(s => ["Git & GitHub","Google Colab","Redes","Seguridad Informática"].includes(s.name))
  }
];

const levelDots: Record<string, number> = { "Básico": 1, "Intermedio": 2, "Avanzado": 3 };
---

<Layout title="Sobre mí | Alejo Tello">
  <Header />
  <WaterDrops />

  <main class="relative z-10 w-full min-h-screen text-white pb-24">

    <!-- ══════════ HERO BIO (NUEVO) ══════════ -->
    <section class="max-w-6xl mx-auto px-6 pt-16 pb-10">
      <div class="relative overflow-hidden">
        <div class="grid lg:grid-cols-[280px_1fr] gap-12 items-center">
          
          <!-- FOTO -->
          <div class="flex justify-center">
            <div class="relative">
              <div class="absolute inset-0 rounded-full bg-gradient-to-r from-cyan-400 to-blue-500 blur-xl opacity-40"></div>
              <div class="relative w-56 h-56 rounded-full overflow-hidden border-[5px] border-cyan-400 shadow-[0_0_45px_#22d3ee]">
                <img
                  src="/img/Fotoibiografia.jpeg"
                  alt="Alejo Tello"
                  class="w-full h-full object-cover object-top"
                />
              </div>
              <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-black/80 border border-green-400/40 rounded-full px-4 py-1.5 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                <span class="text-green-300 text-xs">
                  Disponible
                </span>
              </div>
            </div>
          </div>

          <!-- INFO -->
          <div>
            <p class="text-cyan-300 text-lg mb-2">
              Hola, soy 
            </p>
            <h1 class="text-5xl md:text-7xl font-black leading-none mb-4">
              <span class="bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">
                Alejo
              </span>
              <span class="text-white">
                Tello
              </span>
            </h1>
            <p class="text-cyan-300 text-xl md:text-2xl font-semibold mb-6">
              {basics.label}
            </p>
            <p
              class="text-gray-300 text-lg leading-relaxed max-w-3xl mb-8"
              set:html={basics.summary}
            />

            <div class="flex flex-wrap gap-3 mb-8">
              {[
                "Full Stack Dev",
                "TinyML / IoT",
                "Machine Learning",
                "Python",
                "Edge Impulse"
              ].map(tag => (
                <span class="px-4 py-2 rounded-full border border-cyan-400/30 bg-cyan-400/5 text-cyan-300 hover:border-cyan-400 transition-all">
                  {tag}
                </span>
              ))}
            </div>

            <div class="grid md:grid-cols-2 gap-4">
              <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
                <p class="text-[11px] tracking-[0.25em] text-gray-500 mb-1">
                  UBICACIÓN
                </p>
                <p class="text-white">
                  📍 {basics.location.city}, {basics.location.region}
                </p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
                <p class="text-[11px] tracking-[0.25em] text-gray-500 mb-1">
                  UNIVERSIDAD
                </p>
                <p class="text-white">
                  🎓 Corporación Universitaria Autónoma de Nariño
                </p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
                <p class="text-[11px] tracking-[0.25em] text-gray-500 mb-1">
                  EXPERIENCIA
                </p>
                <p class="text-white">
                  💼 ITD SAS — IoT & ML
                </p>
              </div>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
                <p class="text-[11px] tracking-[0.25em] text-gray-500 mb-1">
                  EMAIL
                </p>
                <p class="text-cyan-300 break-all">
                  📧 {basics.email}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ EXPERIENCIA ══════════ -->
    <section class="max-w-5xl mx-auto px-6 mt-10">
      <div class="flex items-center gap-4 mb-8">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-cyan-400/40 to-cyan-400/60"></div>
        <h2 class="flex items-center gap-2 text-2xl font-extrabold text-white whitespace-nowrap">
          <span class="text-3xl">💼</span> Experiencia
        </h2>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent via-cyan-400/40 to-cyan-400/60"></div>
      </div>

      {work.map(({ name, position, startDate, endDate, summary, highlights }) => {
        const startStr = new Date(startDate).toLocaleDateString("es-CO", { month: "long", year: "numeric" });
        const endStr = endDate ? new Date(endDate).toLocaleDateString("es-CO", { month: "long", year: "numeric" }) : "Actual";
        return (
          <div class="relative bg-white/4 border border-cyan-400/20 rounded-3xl overflow-hidden shadow-[0_0_30px_#0ea5e9]/15 hover:shadow-[0_0_50px_#38bdf8]/30 transition-all duration-500">
            <div class="h-0.5 w-full bg-gradient-to-r from-cyan-400/0 via-cyan-400 to-cyan-400/0"></div>
            <div class="p-8">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-cyan-400/10 border border-cyan-400/30 flex items-center justify-center text-2xl shrink-0 shadow-[0_0_15px_#0ea5e9]/30">
                    🏢
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-white">{name}</h3>
                    <p class="text-cyan-300 text-sm mt-0.5 font-medium">{position}</p>
                  </div>
                </div>
                <div class="flex flex-col items-end gap-1 shrink-0">
                  <span class="text-xs text-gray-400 italic bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg">
                    {startStr} — {endStr}
                  </span>
                  <span class="text-xs text-green-400 font-semibold flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> Completado
                  </span>
                </div>
              </div>

              <p class="text-gray-300 text-sm mb-6 leading-relaxed border-l-2 border-cyan-400/40 pl-4">
                {summary}
              </p>

              <div class="flex flex-wrap gap-2">
                {highlights
                  .filter(h => !h.startsWith("Horario"))
                  .map(h => (
                    <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-gray-300 text-xs hover:border-cyan-400/30 hover:text-cyan-300 transition-all duration-300">
                      <span class="text-cyan-400">▹</span> {h}
                    </span>
                  ))
                }
              </div>

              {highlights.find(h => h.startsWith("Horario")) && (
                <p class="mt-4 text-xs text-gray-500 italic">
                  🕐 {highlights.find(h => h.startsWith("Horario"))}
                </p>
              )}
            </div>
          </div>
        );
      })}
    </section>

    <!-- ══════════ EDUCACIÓN ══════════ -->
    <section class="max-w-5xl mx-auto px-6 mt-16">
      <div class="flex items-center gap-4 mb-8">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-purple-400/40 to-purple-400/60"></div>
        <h2 class="flex items-center gap-2 text-2xl font-extrabold text-white whitespace-nowrap">
          <span class="text-3xl">🎓</span> Educación
        </h2>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent via-purple-400/40 to-purple-400/60"></div>
      </div>

      {education.map(({ institution, area, studyType, startDate, endDate, summary }) => {
        const startYear = new Date(startDate).getFullYear();
        const endYear = endDate ? new Date(endDate).getFullYear() : "Actualidad";
        return (
          <div class="relative bg-white/4 border border-purple-400/20 rounded-3xl overflow-hidden shadow-[0_0_30px_#9333ea]/15 hover:shadow-[0_0_50px_#a855f7]/30 transition-all duration-500">
            <div class="h-0.5 w-full bg-gradient-to-r from-purple-400/0 via-purple-400 to-purple-400/0"></div>
            <div class="p-8 flex flex-col md:flex-row gap-8 items-start">
              <div class="flex flex-col items-center gap-3 md:w-32 shrink-0">
                <div class="w-16 h-16 rounded-2xl bg-purple-400/10 border border-purple-400/30 flex items-center justify-center text-3xl shadow-[0_0_20px_#9333ea]/30">
                  🏫
                </div>
                <div class="text-center">
                  <p class="text-2xl font-extrabold text-purple-300">{startYear}</p>
                  <div class="w-px h-6 bg-purple-400/40 mx-auto my-1"></div>
                  <p class="text-sm font-semibold text-cyan-300">{endYear}</p>
                </div>
                <span class="px-2 py-1 rounded-lg bg-green-400/10 border border-green-400/30 text-green-400 text-xs font-semibold">
                  En curso
                </span>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-extrabold text-white mb-1">{institution}</h3>
                <p class="text-purple-300 font-semibold mb-1">{studyType} en {area}</p>
                <p class="text-gray-300 text-sm leading-relaxed mt-3" set:html={summary} />
                <div class="flex flex-wrap gap-2 mt-4">
                  {["Desarrollo de Software","Bases de Datos","Machine Learning","TinyML","Análisis de Datos"].map(t => (
                    <span class="px-2 py-1 rounded-lg bg-purple-400/10 border border-purple-400/20 text-purple-300 text-xs">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </section>

    <!-- ══════════ HABILIDADES ══════════ -->
    <section class="max-w-5xl mx-auto px-6 mt-16">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-pink-400/40 to-pink-400/60"></div>
        <h2 class="flex items-center gap-2 text-2xl font-extrabold text-white whitespace-nowrap">
          <span class="text-3xl">🧠</span> Habilidades
        </h2>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent via-pink-400/40 to-pink-400/60"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {skillGroups.map(group => (
          <div class={`bg-white/4 border ${group.border} rounded-2xl p-5 ${group.glow} ${group.glowHover} transition-all duration-300 hover:scale-[1.01]`}>
            <div class="flex items-center gap-2 mb-5">
              <span class="text-xl">{group.icon}</span>
              <h3 class={`font-bold text-base ${group.text}`}>{group.label}</h3>
              <span class={`ml-auto text-xs px-2 py-0.5 rounded-full ${group.bg} border ${group.border} ${group.text}`}>
                {group.items.length}
              </span>
            </div>
            <div class="flex flex-col gap-3">
              {group.items.map(skill => {
                const dots = levelDots[skill.level] ?? 1;
                return (
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-gray-200 text-sm font-medium truncate">{skill.name}</span>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="text-gray-500 text-xs">{skill.level}</span>
                      <div class="flex gap-1">
                        {[1,2,3].map(d => (
                          <div class={`w-2 h-2 rounded-full transition-all ${d <= dots ? `${group.bg} border ${group.border} shadow-[0_0_5px] ${group.text}` : 'bg-white/10 border border-white/10'}`}></div>
                        ))}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <section class="max-w-4xl mx-auto px-6 mt-20">
      <div class="relative bg-white/4 border border-white/10 rounded-3xl p-10 text-center overflow-hidden shadow-[0_0_50px_#0ea5e9]/20">
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-400/5 via-transparent to-purple-400/5 pointer-events-none"></div>
        <h2 class="text-3xl md:text-4xl font-extrabold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent mb-3">
          ¿Trabajamos juntos?
        </h2>
        <p class="text-gray-400 mb-8 max-w-md mx-auto">Disponible para proyectos freelance, prácticas o colaboraciones remotas.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/projects" class="px-8 py-3 bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-xl font-bold shadow-[0_0_20px_#0ea5e9] hover:shadow-[0_0_35px_#38bdf8] hover:scale-105 transition-all duration-300">
            🚀 Ver Proyectos
          </a>
          <a href="/contact" class="px-8 py-3 bg-white/10 border border-white/20 text-white rounded-xl font-bold hover:bg-white/20 hover:scale-105 transition-all duration-300">
            📡 Contactar
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 8s linear infinite;
  }
</style>